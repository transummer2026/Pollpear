# --- Commun (tous environnements) ---

#  -- SERVICES POLLPEAR--
NESTJS_PEPPER="saltybitches"
# openssl rand -hex 32
API_KEYS_PEPPER="CHANGE_ME"
# openssl rand -hex 32
SESSION_COOKIE_SECRET="CHANGE_ME"
BACKEND_URL="http://backend:3000"

#   - Oauth -
OAUTH_42_CLIENT_ID="CHANGE_ME"
OAUTH_42_CLIENT_SECRET="CHANGE_ME"
OAUTH_42_REDIRECT_URI="http://backend:3000/auth/oauth/school42/callback"

OAUTH_GITHUB_CLIENT_ID="CHANGE_ME"
OAUTH_GITHUB_CLIENT_SECRET="CHANGE_ME"
OAUTH_GITHUB_REDIRECT_URI="http://backend:3000/auth/oauth/github/callback"

OAUTH_GOOGLE_CLIENT_ID="CHANGE_ME"
OAUTH_GOOGLE_CLIENT_SECRET="CHANGE_ME"
OAUTH_GOOGLE_REDIRECT_URI="http://backend:3000/auth/oauth/google/callback"

#   - Mail -
MAIL_HOST="mail.infomaniak.com"
MAIL_PORT="587"
MAIL_USER="info@pollpear.com"
MAIL_PASS='CHANGE_ME'
MAIL_FROM="Pollpear <no-reply@pollpear.com>"

#  -- SERVICE INFRA --

#   - Vault -
VAULT_ADDR="http://127.0.0.1:8200"
VAULT_ROOT_TOKEN="truc"

#   - PostgreSQL -
POSTGRES_USER="pollpear"
POSTGRES_DB="pollpear"
POSTGRES_PASSWORD="pollpear"
POSTGRES_URL="postgresql://pollpear:pollpear@postgres:5432/pollpear?schema=public"

#   - Redis -
REDIS_PASSWORD="pollpear"
REDIS_URL="redis://:pollpear@redis:6379"


#  - Grafana -
GRAFANA_USER="admin"
GRAFANA_PASSWORD="machin"

#   - Garage (S3 object storage) - 
# secrets à générer une fois (commande au-dessus de chaque)
# openssl rand -hex 32
GARAGE_RPC_SECRET="CHANGE_ME"
# openssl rand -base64 32
GARAGE_ADMIN_TOKEN="CHANGE_ME"
GARAGE_S3_ENDPOINT="http://garage:3900"
GARAGE_S3_URL="http://garage:3092"
GARAGE_S3_UPLOADS_HOST="pollpear-uploads.web.garage.localhost"
GARAGE_S3_REGION="garage"
GARAGE_S3_BUCKET="pollpear-uploads"
# echo "GK$(openssl rand -hex 12)"
GARAGE_S3_ACCESS_KEY="CHANGE_ME"
# openssl rand -hex 32
GARAGE_S3_SECRET_KEY="CHANGE_ME"
#   - WAF -

ACCESSLOG="/var/log/nginx/access.log"
ALLOWED_HTTP_VERSIONS="HTTP/1.0 HTTP/1.1 HTTP/2 HTTP/2.0"
ALLOWED_METHODS="GET HEAD POST OPTIONS"
ALLOWED_REQUEST_CONTENT_TYPE="|application/x-www-form-urlencoded| |multipart/form-data| |multipart/related| |text/xml| |application/xml| |application/soap+xml| |application/json| |application/cloudevents+json| |application/cloudevents-batch+json|"
ALLOWED_REQUEST_CONTENT_TYPE_CHARSET="|utf-8| |iso-8859-1| |iso-8859-15| |windows-1252|"
ANOMALY_INBOUND="5"
ANOMALY_OUTBOUND="4"
BACKEND="http://backend:3000"
BLOCKING_PARANOIA="1"
CLIENT_BODY_TIMEOUT="10s"
CORS_HEADER_403_ALLOW_METHODS="GET, POST, PUT, DELETE, OPTIONS"
CORS_HEADER_403_ALLOW_ORIGIN="*"
CORS_HEADER_403_CONTENT_TYPE="text/html"
CORS_HEADER_403_MAX_AGE="3600"
CRS_DISABLE_PLUGINS="0"
CRS_ENABLE_TEST_MARKER="0"
DETECTION_PARANOIA="1"
ENFORCE_BODYPROC_URLENCODED="0"
ERRORLOG="/proc/self/fd/2"
HTTP2="on"
KEEPALIVE_TIMEOUT="60s"
LOGLEVEL="warn"
MANUAL_MODE="0"
METRICS_ALLOW_FROM="127.0.0.0/24"
METRICS_DENY_FROM="all"
METRICSLOG="/dev/null"
MODSEC_ARGUMENTS_LIMIT="1000"
MODSEC_AUDIT_ENGINE="RelevantOnly"
MODSEC_AUDIT_LOG="/dev/stdout"
MODSEC_AUDIT_LOG_FORMAT="JSON"
MODSEC_AUDIT_LOG_PARTS="ABIJDEFHZ"
MODSEC_AUDIT_LOG_RELEVANT_STATUS="^(?:5|4(?!04))"
MODSEC_AUDIT_LOG_TYPE="Serial"
MODSEC_AUDIT_STORAGE_DIR="/var/log/modsecurity/audit/"
MODSEC_DATA_DIR="/tmp/modsecurity/data"
MODSEC_DEBUG_LOG="/dev/null"
MODSEC_DEBUG_LOGLEVEL="0"
MODSEC_REQ_BODY_ACCESS="on"
MODSEC_REQ_BODY_JSON_DEPTH_LIMIT="512"
MODSEC_REQ_BODY_LIMIT="13107200"
MODSEC_REQ_BODY_LIMIT_ACTION="Reject"
MODSEC_REQ_BODY_NOFILES_LIMIT="131072"
MODSEC_RESP_BODY_ACCESS="on"
MODSEC_RESP_BODY_LIMIT="1048576"
MODSEC_RESP_BODY_LIMIT_ACTION="ProcessPartial"
MODSEC_RESP_BODY_MIMETYPE="text/plain text/html text/xml"
MODSEC_RULE_ENGINE="on"
MODSEC_STATUS_ENGINE="Off"
MODSEC_TAG="modsecurity"
MODSEC_TMP_DIR="/tmp/modsecurity/tmp"
MODSEC_UNICODE_MAPPING="20127"
MODSEC_UPLOAD_DIR="/tmp/modsecurity/upload"
MODSEC_UPLOAD_FILE_MODE="0600"
MODSEC_UPLOAD_KEEP_FILES="Off"
NGINX_ALWAYS_TLS_REDIRECT="off"
NGINX_PORT_IN_REDIRECT="off"
NGINX_WORKER_PROCESSES="auto"
PORT="8080"
PROXY_SSL="off"
PROXY_SSL_CERT_FILE="/etc/nginx/conf/proxy.crt"
PROXY_SSL_CERT_KEY_FILE="/etc/nginx/conf/proxy.key"
PROXY_SSL_CIPHERS="ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384"
PROXY_SSL_PROTOCOLS="TLSv1.2 TLSv1.3"
PROXY_SSL_VERIFY="off"
PROXY_SSL_VERIFY_DEPTH="1"
PROXY_TIMEOUT="60s"
REAL_IP_HEADER="X-REAL-IP"
REAL_IP_PROXY_HEADER="X-REAL-IP"
REAL_IP_RECURSIVE="on"
REPORTING_LEVEL="4"
RESOLVER_CONFIG="valid=5s"
RESTRICTED_EXTENSIONS=".asa/ .asax/ .ascx/ .axd/ .backup/ .bak/ .bat/ .cdx/ .cer/ .cfg/ .cmd/ .com/ .config/ .conf/ .cs/ .csproj/ .csr/ .dat/ .db/ .dbf/ .dll/ .dos/ .htr/ .htw/ .ida/ .idc/ .idq/ .inc/ .ini/ .key/ .licx/ .lnk/ .log/ .mdb/ .old/ .pass/ .pdb/ .pol/ .printer/ .pwd/ .rdb/ .resources/ .resx/ .sql/ .swp/ .sys/ .vb/ .vbs/ .vbproj/ .vsdisco/ .webinfo/ .xsd/ .xsx/"
RESTRICTED_HEADERS_BASIC="/content-encoding/ /proxy/ /lock-token/ /content-range/ /if/ /x-http-method-override/ /x-http-method/ /x-method-override/"
RESTRICTED_HEADERS_EXTENDED="/accept-charset/"
SERVER_NAME="localhost"
SERVER_TOKENS="off"
SET_REAL_IP_FROM="127.0.0.1"
SSL_CERT_FILE="/etc/nginx/conf/server.crt"
SSL_CERT_KEY_FILE="/etc/nginx/conf/server.key"
SSL_CIPHERS="ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384"
SSL_DH_BITS="2048"
SSL_OCSP_STAPLING="on"
SSL_PORT="8443"
SSL_PREFER_CIPHERS="off"
SSL_PROTOCOLS="TLSv1.2 TLSv1.3"
SSL_VERIFY="off"
SSL_VERIFY_DEPTH="1"
STATIC_EXTENSIONS="/.jpg/ /.jpeg/ /.png/ /.gif/ /.js/ /.css/ /.ico/ /.svg/ /.webp/"
VALIDATE_UTF8_ENCODING="0"
WORKER_CONNECTIONS="1024"

